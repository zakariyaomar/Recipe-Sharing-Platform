generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  recipes   Recipe[]
  favorites Favorite[]
  ratings   Rating[]
}

model Recipe {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  prepTime    Int
  cookTime    Int
  servings    Int        @default(4)
  difficulty  String     @default("medium")
  category    String
  ingredients Json
  steps       Json
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User       @relation(fields: [authorId], references: [id])
  authorId    Int
  favorites   Favorite[]
  ratings     Rating[]

  @@index([category])
  @@index([authorId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

model Rating {
  id       Int    @id @default(autoincrement())
  value    Int // 1-5 stars
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId Int

  @@unique([userId, recipeId])
}
